# Local defaults — copy to .env only if you need to override
# cp .env.example .env

# Database configuration
DB_USERNAME=library
DB_PASSWORD=library
DB_NAME=library-is-db
# Host app / IDE: localhost. Docker app service overrides this to postgres:5432/...
DB_URL=localhost:5432/library-is-db

# PgAdmin configuration (docker compose --profile tools)
PGA_USERNAME=admin@library.local
PGA_PASSWORD=admin
