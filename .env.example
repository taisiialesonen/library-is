# Optional overrides — copy only if needed:
#   cp .env.example .env
#
# Defaults work for IDE debug (localhost) and Docker demo/prod.

# Database
DB_USERNAME=library
DB_PASSWORD=library
DB_NAME=library-is-db
# Host / IDE: localhost. Docker app service overrides to postgres:5432/...
DB_URL=localhost:5432/library-is-db

# PgAdmin (docker compose --profile tools)
PGA_USERNAME=admin@library.local
PGA_PASSWORD=admin
